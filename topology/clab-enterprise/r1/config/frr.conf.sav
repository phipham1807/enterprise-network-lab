frr version 10.7.1_git
frr defaults traditional
hostname r1
domainname localdomain
service integrated-vtysh-config
!
ip prefix-list BLOCK_PCA seq 5 deny 10.10.20.0/24
ip prefix-list BLOCK_PCA seq 10 permit any
!
route-map PERMIT_ALL permit 10
exit
!
route-map RM_BGP_OUT permit 10
 match ip address prefix-list BLOCK_PCA
exit
!
interface eth1
 ip address 172.16.12.1/30
 ip ospf network point-to-point
 no ip ospf passive
exit
!
interface eth2
 ip address 172.16.13.1/30
 ip ospf network point-to-point
 no ip ospf passive
exit
!
interface eth3
 ip address 172.16.15.1/30
 ip ospf network point-to-point
 no ip ospf passive
exit
!
interface eth4
 ip address 10.10.10.1/24
exit
!
interface lo
 ip address 10.255.0.1/32
exit
!
router bgp 65001
 neighbor 172.16.15.2 remote-as 65005
 !
 address-family ipv4 unicast
  redistribute ospf
  neighbor 172.16.15.2 route-map PERMIT_ALL in
  neighbor 172.16.15.2 route-map RM_BGP_OUT out
 exit-address-family
exit
!
router ospf
 ospf router-id 10.255.0.1
 redistribute bgp
 passive-interface default
 network 10.10.10.0/24 area 0.0.0.0
 network 10.255.0.1/32 area 0.0.0.0
 network 172.16.12.0/30 area 0.0.0.0
 network 172.16.13.0/30 area 0.0.0.0
 network 172.16.15.0/30 area 0.0.0.0
exit
!
